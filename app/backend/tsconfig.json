{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "src/jest.config.ts",
    "./src/**/*.tsx",
    "./src/**/*.ts",
    "src/singleton.ts"
  ],
  "exclude": ["node_modules", "**/*.spec.ts"]
}